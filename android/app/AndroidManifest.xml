<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sfwm.bridge"
    android:versionCode="1"
    android:versionName="0.1.0">

    <application
        android:label="@string/app_name"
        android:directBootAware="true"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- One hosted output is one task: an application-band window, so ordering against
             the shell's own floating windows follows focus instead of window type.
             The module runs inside the shell's process, so the start does not come from our
             own uid: the activity has to be exported. It holds nothing but an empty surface,
             and a window it creates is a plain task, so the exposure is only that another
             application could open a blank task. -->
        <activity
            android:name=".display.HostActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:launchMode="standard"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Owns a full-screen Surface that the unprivileged presentation path renders into.
             Exported for the same reason as the window above: the start comes from the shell's
             process. It is not touchable and shows nothing of its own, so opening it only puts a
             blank presenter on screen. -->
        <activity
            android:name=".display.PresentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode" />
    </application>
</manifest>
