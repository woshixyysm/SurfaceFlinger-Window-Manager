<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sfwm.bridge"
    android:versionCode="1"
    android:versionName="0.1.0">

    <application
        android:label="@string/app_name"
        android:directBootAware="true"
        android:allowBackup="false">

        <!-- One hosted output is one task: an application-band window, so ordering against
             the shell's own floating windows follows focus instead of window type.
             The module runs inside the shell's process, so the start does not come from our
             own uid: the activity has to be exported, and the shell's signature permission is
             what keeps every other application out. -->
        <activity
            android:name=".display.HostActivity"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:launchMode="standard"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode" />
    </application>
</manifest>
